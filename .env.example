# Neon (set automatically during setup)
DATABASE_URL=

# Home Assistant (through your Cloudflare tunnel)
HA_URL=https://ha.example.com
HA_TOKEN=            # Long-lived access token: HA profile → Security → Long-lived tokens

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550100   # Your Twilio phone number, E.164 format
TWILIO_VOICE=Polly.Joanna-Neural

# Dashboard login
DASHBOARD_PASSWORD=
SESSION_SECRET=      # Any long random string

# Secret the outside pinger sends to /api/tick?key=...
CRON_SECRET=

# Optional
APP_TZ=America/New_York
APP_URL=             # e.g. https://zmanim-caller.vercel.app (auto-detected on Vercel)
IN_ISRAEL=false
